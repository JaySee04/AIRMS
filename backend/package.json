{
  "name": "airms-backend",
  "version": "0.1.0",
  "description": "AIRMS Node.js/Express REST API (MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seeder.js",
    "test": "jest",
    "verify:vision": "node scripts/verify-holomotion-extract.js",
    "mail:tick": "node src/mailTick.js",
    "guide:pdf": "node scripts/guide-to-pdf.js && node scripts/verify-guide-pdf.js",
    "measure:facts": "node scripts/measure-facts.js",
    "migrate:screening-unique": "node scripts/migrate-screening-unique.js",
    "audit:access": "node scripts/audit-access.js",
    "coverage": "jest --coverage --coverageReporters=text-summary"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas": "npm:@napi-rs/canvas@^0.1.100",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.4",
    "nodemailer": "^8.0.10",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.18.0",
    "sequelize": "^6.37.8",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
