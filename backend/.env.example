NODE_ENV=development
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# MySQL — wrap the password in single quotes if it contains #, $, % or ^
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=''
MYSQL_DATABASE=airms

# SMTP — used by /auth/forgot-password to send password reset emails.
# If SMTP_HOST is unset, the mailer falls back to a console transport
# (prints the email body + reset link to the backend terminal). Set the
# values below to send real emails through any SMTP provider.
#
# Gmail example (requires a Google 2FA app password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=<16-character app password from Google account security>
#   SMTP_FROM=AIRMS <your.address@gmail.com>
#
# Mailtrap example (free dev mailbox; perfect for testing without a real inbox):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=<your mailtrap username>
#   SMTP_PASS=<your mailtrap password>
#   SMTP_FROM=AIRMS <no-reply@airms.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='AIRMS <no-reply@airms.local>'
