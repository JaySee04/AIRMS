{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{@napi-rs,tesseract.js-core,pdfjs-dist,pdfkit/js/standard-fonts}/**"
    },
    "api/cron/mail-tick.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/mail-tick",
      "schedule": "0 23 * * *"
    }
  ]
}
